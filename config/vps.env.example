# VPS / docker compose secrets — copy and edit:
#   cp config/vps.env.example .env.vps
#   docker compose --env-file .env.vps up -d --build

# Public URL (must match TLS hostname)
APP_URL=https://shelfy.example.co.tz

# Host port mapped to container :3000
SHELFY_HOST_PORT=3000

POSTGRES_USER=shelfy
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=shelfy

JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars

PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_SANDBOX_KEY=

ALLOW_DEMO_LOGIN=false

RESEND_API_KEY=
EMAIL_FROM=Shelfy <noreply@shelfy.co.tz>

# Optional S3-compatible object storage (recommended on VPS without large volumes)
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=

GEMINI_API_KEY=
