# Copy to repo root as `.env` for local preview (gitignored):
#   cp config/local.preview.env .env
#
# Or use: npm run dev:3007 (sets PORT, APP_URL, JWT_SECRET, ALLOW_DEMO_LOGIN)

PORT=3007
APP_URL=http://localhost:3007
NODE_ENV=development

# JSON file DB in data/shelfy.json (leave empty). For Postgres locally, set DATABASE_URL.
DATABASE_URL=

ALLOW_DEMO_LOGIN=true
PESAPAL_ENVIRONMENT=sandbox

# Optional: sandbox payment completion without PesaPal API (set in local .env only)
# PESAPAL_SANDBOX_KEY=

# AI features optional locally
# GEMINI_API_KEY=
