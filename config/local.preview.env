# Copy to repo root as `.env` for local preview (gitignored):
#   cp config/local.preview.env .env
#
# Or use: npm run dev:3007

PORT=3007
APP_URL=http://localhost:3007
NODE_ENV=development

# Stable local JWT (required length for tests; set a unique secret on VPS)
JWT_SECRET=local_dev_jwt_secret_min_32_chars_for_shelfy

# JSON file DB in data/shelfy.json (leave empty). For Postgres locally, set DATABASE_URL.
DATABASE_URL=

ALLOW_DEMO_LOGIN=true
PESAPAL_ENVIRONMENT=sandbox

# Optional: sandbox payment completion without PesaPal API (generate a random string)
PESAPAL_SANDBOX_KEY=local_sandbox_hmac_key_change_me

# AI features optional locally
GEMINI_API_KEY=
