# Example nginx site for Shelfy behind TLS on a VPS.
# Replace shelfy.example.co.tz and upstream port if needed.
#
#   sudo cp deploy/nginx/shelfy.conf.example /etc/nginx/sites-available/shelfy
#   sudo ln -sf /etc/nginx/sites-available/shelfy /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Obtain certificates with certbot (Let's Encrypt) before enabling ssl blocks.

upstream shelfy_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name shelfy.example.co.tz;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name shelfy.example.co.tz;

    ssl_certificate     /etc/letsencrypt/live/shelfy.example.co.tz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shelfy.example.co.tz/privkey.pem;

    client_max_body_size 12m;

    location / {
        proxy_pass http://shelfy_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
