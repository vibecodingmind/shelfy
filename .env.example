# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Authentication secret for JWT tokens (generate a long random string for production)
JWT_SECRET="replace_with_a_long_random_secret"

# Postgres connection. When set, Shelfy stores all app data in Railway Postgres.
# Leave empty for local JSON file storage in data/shelfy.json
DATABASE_URL=""

# PesaPal v3 Payment Gateway Credentials
PESAPAL_CONSUMER_KEY="pesapal_consumer_key"
PESAPAL_CONSUMER_SECRET="pesapal_consumer_secret"
PESAPAL_ENVIRONMENT="sandbox" # or "live"
PESAPAL_IPN_ID=""
PESAPAL_SANDBOX_KEY=""

# Allow seeded demo accounts in production (default off when NODE_ENV=production)
ALLOW_DEMO_LOGIN="false"

# Optional S3-compatible uploads (local disk if unset; S3 PUT failures fall back to local)
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_PUBLIC_BASE_URL=""

# Optional email (Resend is wired; SMTP_URL only marks email as configured)
RESEND_API_KEY=""
SMTP_URL=""
EMAIL_FROM="Shelfy <noreply@shelfy.co.tz>"

# Optional SMS (Africa's Talking or Twilio). In-app notifications always write.
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
