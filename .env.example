# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public origin for Azam Pay callbacks, email links, and OAuth.
APP_URL="MY_APP_URL"

# Authentication secret for JWT tokens (generate a long random string for production)
JWT_SECRET="replace_with_a_long_random_secret"

# Postgres connection. When set, Shelfy stores all app data in Railway Postgres.
DATABASE_URL=""

# Azam Pay — primary payment gateway (M-Pesa, Tigo, Airtel, Halopesa, AzamPesa)
AZAMPAY_APP_NAME="your_app_name"
AZAMPAY_CLIENT_ID="your_client_id"
AZAMPAY_CLIENT_SECRET="your_client_secret"
AZAMPAY_API_KEY=""
AZAMPAY_ENVIRONMENT="sandbox"
AZAMPAY_AUTH_URL=""
AZAMPAY_BASE_URL=""
AZAMPAY_CALLBACK_PASSWORD=""
AZAMPAY_SANDBOX_KEY=""

# Allow seeded demo accounts in production (default off when NODE_ENV=production)
ALLOW_DEMO_LOGIN="false"

# Optional S3-compatible uploads
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_PUBLIC_BASE_URL=""

# Email — VPS production: use self-hosted Postfix (SMTP_*). Leave RESEND empty on VPS.
# SMTP takes precedence over RESEND when both are set.
SMTP_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
# Allow Postfix/self-signed TLS on localhost (default-on for 127.0.0.1 in code)
SMTP_TLS_INSECURE="true"
RESEND_API_KEY=""
EMAIL_FROM="Shelfy <noreply@shelfy.co.tz>"
EMAIL_REPLY_TO="hello@shelfy.co.tz"

# Optional SMS
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
